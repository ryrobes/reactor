(ns reactor.time-travel-test
  (:require [clojure.test :refer :all]
            [reactor.time-travel :as tt]))

(deftest basic-time-travel-test
  (testing "Basic undo/redo operations"
    (let [atom (tt/time-travel-atom {:counter 0})]
      ;; Make some changes
      (swap! atom update :counter inc)  ; counter = 1
      (swap! atom update :counter inc)  ; counter = 2
      (swap! atom update :counter inc)  ; counter = 3
      
      (is (= 3 (:counter @atom)))
      
      ;; Undo
      (tt/undo! atom)
      (is (= 2 (:counter @atom)))
      
      (tt/undo! atom)
      (is (= 1 (:counter @atom)))
      
      ;; Redo
      (tt/redo! atom)
      (is (= 2 (:counter @atom)))
      
      (tt/redo! atom)
      (is (= 3 (:counter @atom)))
      
      ;; Redo when nothing to redo
      (tt/redo! atom)
      (is (= 3 (:counter @atom)))))
  
  (testing "Clear future on new change"
    (let [atom (tt/time-travel-atom {:x 0})]
      (reset! atom {:x 1})
      (reset! atom {:x 2})
      (tt/undo! atom)  ; x = 1
      (tt/undo! atom)  ; x = 0
      
      ;; Make new change - should clear redo stack
      (reset! atom {:x 99})
      (tt/redo! atom)  ; Should do nothing
      (is (= 99 (:x @atom))))))

(deftest checkpoint-test
  (testing "Named checkpoints"
    (let [atom (tt/time-travel-atom {:data "initial"})]
      (tt/checkpoint! atom :start)
      
      (reset! atom {:data "modified"})
      (reset! atom {:data "modified-again"})
      
      (tt/checkpoint! atom :middle)
      
      (reset! atom {:data "final"})
      
      ;; Jump to checkpoints
      (tt/jump-to! atom :middle)
      (is (= "modified-again" (:data @atom)))
      
      (tt/jump-to! atom :start)
      (is (= "initial" (:data @atom)))))
  
  (testing "Undoable macro"
    (let [atom (tt/time-travel-atom {:value 0})]
      (try
        (tt/undoable atom
          (swap! atom assoc :value 10)
          (swap! atom assoc :value 20)
          (throw (Exception. "Oops!")))
        (catch Exception e
          ;; Should have rolled back
          (is (= 0 (:value @atom))))))))

(deftest history-query-test
  (testing "History retrieval"
    (let [atom (tt/time-travel-atom {:x 0})]
      (swap! atom assoc :x 1)
      (Thread/sleep 10)
      (swap! atom assoc :x 2)
      (Thread/sleep 10)
      (swap! atom assoc :x 3)
      
      (let [history (tt/get-history atom)]
        (is (= 3 (count history)))
        (is (every? :timestamp history))
        (is (every? :event history)))))
  
  (testing "Filtered history"
    (let [atom (tt/time-travel-atom {:x 0})]
      ;; Add some changes
      (swap! atom assoc :x 1)
      (swap! atom assoc :x 2)
      (swap! atom assoc :x 3)
      
      (let [history (tt/get-history atom {:last 1})]
        (is (= 1 (count history)))))))

(deftest memory-management-test
  (testing "Ring buffer behavior"
    (let [atom (tt/time-travel-atom {:n 0} :max-history 5)]
      ;; Add more than max-history changes
      (dotimes [i 10]
        (swap! atom assoc :n i))
      
      ;; History should be capped at 5
      (is (<= (count (tt/get-history atom)) 5))
      
      ;; Should keep most recent
      (let [history (tt/get-history atom)]
        (is (= 9 (:n (:state (last history)))))))))

(deftest patch-calculation-test
  (testing "Efficient patches"
    (let [old-state {:a 1 :b 2 :c 3}
          new-state {:a 1 :b 99 :c 3 :d 4}
          patch (#'tt/calculate-patch old-state new-state)]
      (is (= {:b 99 :d 4} (:added patch)))
      (is (nil? (:removed patch))))))

(deftest session-branching-test
  (testing "Session branches"
    (let [atom (tt/time-travel-atom {:shared 0 :user1 nil :user2 nil})]
      ;; Main timeline
      (swap! atom assoc :shared 1)
      
      ;; User 1 branch
      (tt/branch! atom "user1")
      (swap! atom assoc :user1 "data1")
      
      ;; User 2 branch
      (tt/branch! atom "user2")
      (swap! atom assoc :user2 "data2")
      
      ;; Branches shouldn't affect each other
      (is (= 1 (:shared @atom)))
      
      ;; Merge branches
      (tt/merge-branch! atom "user1")
      (is (= "data1" (:user1 @atom))))))

(deftest replay-test
  (testing "Event replay"
    (let [atom (tt/time-travel-atom {:x 0})
          events (atom [])]
      
      ;; Record some events
      (swap! atom update :x inc)
      (swap! atom update :x inc)
      (swap! atom update :x inc)
      
      ;; Reset
      (reset! atom {:x 0})
      
      ;; Replay with callback
      (let [start (first (tt/get-history atom))
            end (last (tt/get-history atom))]
        (tt/replay! atom 
                    (:timestamp start)
                    (:timestamp end)
                    :on-step #(swap! events conj %)))
      
      (is (= 3 (count @events))))))

(deftest diff-states-test
  (testing "State diffing"
    (let [atom (tt/time-travel-atom {:a 1})]
      (let [t1 (System/currentTimeMillis)]
        (Thread/sleep 10)
        (swap! atom assoc :b 2)
        (let [t2 (System/currentTimeMillis)]
          (Thread/sleep 10)
          (swap! atom assoc :c 3)
          
          (let [[only-in-t1 only-in-t2 in-both] (tt/diff-states atom t1 t2)]
            (is (nil? only-in-t1))
            (is (= {:b 2} only-in-t2))
            (is (= {:a 1} in-both))))))))

(deftest storage-backend-test
  (testing "Memory store"
    (let [store (tt/memory-store 3)
          entries [{:timestamp 1 :data "a"}
                   {:timestamp 2 :data "b"}
                   {:timestamp 3 :data "c"}
                   {:timestamp 4 :data "d"}]]
      
      (doseq [entry entries]
        (.store-entry store entry))
      
      ;; Should only keep last 3
      (is (= 3 (count (.retrieve-last store 10))))
      
      ;; Should be able to retrieve range
      (let [range (.retrieve-range store 2 3)]
        (is (= 2 (count range))))
      
      ;; Pruning
      (.prune-before store 3)
      (is (= 2 (count (.retrieve-last store 10)))))))

(deftest integration-test
  (testing "Full time-travel workflow"
    (let [atom (tt/time-travel-atom {:todos {}
                                      :filter :all})]
      ;; Add todos
      (swap! atom assoc-in [:todos 1] {:text "Buy milk" :done false})
      (tt/checkpoint! atom :after-first-todo)
      
      (swap! atom assoc-in [:todos 2] {:text "Walk dog" :done false})
      (swap! atom update-in [:todos 1 :done] not)  ; Mark as done
      
      (tt/checkpoint! atom :after-second-todo)
      
      ;; Add third todo and mark second as done
      (swap! atom assoc-in [:todos 3] {:text "Write code" :done false})
      (swap! atom update-in [:todos 2 :done] not)
      
      ;; Now let's time travel!
      
      ;; Go back to when we had one todo
      (tt/jump-to! atom :after-first-todo)
      (is (= 1 (count (:todos @atom))))
      (is (false? (get-in @atom [:todos 1 :done])))
      
      ;; Go to second checkpoint
      (tt/jump-to! atom :after-second-todo)
      (is (= 2 (count (:todos @atom))))
      (is (true? (get-in @atom [:todos 1 :done])))
      
      ;; Undo a few times
      (tt/undo! atom)
      (is (false? (get-in @atom [:todos 1 :done])))
      
      (tt/undo! atom)
      (is (= 1 (count (:todos @atom))))
      
      ;; Redo
      (tt/redo! atom)
      (is (= 2 (count (:todos @atom)))))))

(deftest performance-test
  (testing "Performance targets"
    (let [atom (tt/time-travel-atom {:counter 0})]
      ;; Generate history
      (dotimes [_ 100]
        (swap! atom update :counter inc))
      
      ;; Test undo performance
      (let [start (System/currentTimeMillis)]
        (tt/undo! atom)
        (let [duration (- (System/currentTimeMillis) start)]
          (is (< duration 10) "Undo should be < 10ms")))
      
      ;; Test history query performance
      (let [start (System/currentTimeMillis)]
        (tt/get-history atom)
        (let [duration (- (System/currentTimeMillis) start)]
          (is (< duration 50) "History query should be < 50ms"))))))